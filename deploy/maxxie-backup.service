[Unit]
Description=Sauvegarde et test de restauration des bases Maxxie
After=maxxie-bot.service

[Service]
Type=oneshot
User=maxxie-bot
Group=maxxie-bot
EnvironmentFile=/etc/maxxie-bot.env
ExecStart=/usr/bin/python3 /opt/maxxie-bot/backups.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=maxxie-bot
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=300
