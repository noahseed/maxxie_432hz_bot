BOT_TOKEN=remplacer_par_le_jeton_BotFather
# Identifiant NUMERIQUE : généralement -100… pour un supergroupe ou un canal.
# Les noms GROUP_ID/GROUP_URL sont conservés ; le type est détecté automatiquement.
GROUP_ID=
GROUP_URL=https://t.me/Maxxie_432Hz
RULES_FILE=/opt/maxxie-bot/rules.txt
WELCOME_FILE=/opt/maxxie-bot/welcome.txt
# Comptes explicitement autorisés à devenir administrateurs (IDs numériques).
ADMIN_USER_IDS=
# Sous-ensemble des administrateurs autorisés : suppression et gestion des membres.
MODERATOR_USER_IDS=
# Destinataire privé des notifications de premier /start (doit avoir démarré le bot).
NOTIFY_CHAT_ID=
OWNER_USER_ID=
# PostgreSQL local, authentification peer du compte système maxxie-bot.
DATABASE_URL=postgresql:///maxxie_bot?host=/var/run/postgresql
# Chemins historiques, utilisés uniquement sans DATABASE_URL (tests/migration).
VISITORS_DB=/var/lib/maxxie-bot/visitors.sqlite3
STATE_DB=/var/lib/maxxie-bot/tasks.sqlite3
BACKUP_DIR=/var/lib/maxxie-bot/backups
BACKUP_KEEP=14
# Certificat public uniquement. La clé privée reste sur l'ordinateur.
BACKUP_CERT=
# IPv4 recommandé sur ce VPS dont la route IPv6 vers Telegram ne répond pas.
TELEGRAM_IPV4_ONLY=1
# Maintenance VPS : utilise OWNER_USER_ID (sinon NOTIFY_CHAT_ID) en privé.
# Horaire défini par deploy/maxxie-vps-check.timer : 11 h Europe/Paris.
# Assistant privé OpenAI : activé seulement si la clé ET le modèle sont renseignés.
OPENAI_API_KEY=
OPENAI_MODEL=
# État du traitement des pochettes. Les jaquettes JPEG sont conservées dans STATE_DB.
COVERS_DIR=/var/lib/maxxie-bot/covers
